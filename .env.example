# ──────────────────────────────────────────────────────────────────────────
# CivicPulse — environment variables
# Copy this file to `.env` (repo root) and fill in real values.
# NOTHING in here should ever contain a real secret committed to git.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=local                       # local | staging | production
APP_NAME=CivicPulse
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata               # IST end-to-end

# ── Database (native local cluster lives in tools/pgdata on port 5433) ────
# Driver is psycopg v3:  postgresql+psycopg://user:pass@host:port/db
DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@localhost:5433/civicpulse
# Synchronous URL used by Alembic (same value is fine):
ALEMBIC_DATABASE_URL=postgresql+psycopg://civicpulse:civicpulse@localhost:5433/civicpulse

# ── Redis (broker + result backend + dashboard read cache) ────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Encryption at rest ────────────────────────────────────────────────────
# Fernet key used to encrypt meta_token (and other secrets) in the DB.
# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=replace-with-generated-fernet-key

# ── Ingestion cadence ─────────────────────────────────────────────────────
INGESTION_INTERVAL_MINUTES=30
DUMMY_TASK_INTERVAL_SECONDS=30      # WP1 heartbeat task (insert mock mention)

# Offline demo mode: use Fake external clients (no real API keys needed). Set to
# false only once real Meta/FCM/NLP/X credentials below are filled in.
USE_FAKE_CLIENTS=true
DASHBOARD_CACHE_TTL_SECONDS=60
SPIKE_MULTIPLIER=2.5
SPIKE_MIN_ABSOLUTE=5

# ── Meta (WP2) ────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/meta/callback
META_GRAPH_API_VERSION=v19.0
# Data path: "facebook" (needs a linked Facebook Page) or "instagram_login"
# (graph.instagram.com — NO Facebook Page required).
META_SOURCE=facebook

# ── Firebase Cloud Messaging (WP5) ────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# ── Google Natural Language API (WP8) ─────────────────────────────────────
GOOGLE_NL_API_KEY=
NLP_SAMPLE_RATE=0.5                 # cost-control sampling

# ── X via SocialData.tools (WP9) ──────────────────────────────────────────
SOCIALDATA_API_KEY=

# ── Scraper supplement for broad public Instagram chatter (paid) ──────────
SCRAPER_PROVIDER=fake               # fake | apify | socialdata
SCRAPER_API_KEY=
SCRAPER_QUERIES=                    # e.g. @demo_netaji,#demonetaji,"Demo Netaji"

# ── ManyChat (WP6) ────────────────────────────────────────────────────────
MANYCHAT_WEBHOOK_SECRET=

# ── LLM for AI Brief + topic batch (WP9/WP11) ─────────────────────────────
OPENAI_API_KEY=
AI_BRIEF_MODEL=gpt-4o-mini

# OpenRouter (OpenAI-compatible) — preferred LLM path. Get a key at openrouter.ai.
# OPENROUTER_MODEL: any current free model (see https://openrouter.ai/models, ":free" suffix),
# e.g. meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free,
# nvidia/llama-3.1-nemotron-70b-instruct:free, deepseek/deepseek-chat:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# X (Twitter) via SocialData.tools
SOCIALDATA_API_KEY=
X_QUERIES=                          # e.g. @demo_netaji,"Demo Netaji"

# ── Frontend (Vite reads VITE_* at build time) ────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
